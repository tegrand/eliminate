generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  DELETED
}

enum ProfileType {
  SUPER_ADMIN
  CLIENT
  AGENCY
  WORKER
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  displayName String
  description String?
  isSystem    Boolean @default(true)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       User[]

  @@index([isActive])
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  displayName String
  description String?
  module      String
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@index([module])
  @@index([isActive])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  status       UserStatus  @default(PENDING)
  profileType  ProfileType

  firstName String?
  lastName  String?
  phone     String?
  avatar    String?
  timezone  String?
  language  String?

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  verificationTokenHash      String?
  verificationTokenExpiresAt DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?

  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  roleId String
  role   Role    @relation(fields: [roleId], references: [id])
  worker Worker?
  client Client?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  agency        Agency?
  authAuditLogs AuthAuditLog[]

  @@index([email])
  @@index([roleId])
  @@index([status])
}

enum AuthAction {
  LOGIN
  LOGOUT
  FAILED_LOGIN
  REFRESH
  PASSWORD_CHANGE
  ACCOUNT_LOCK
}

model AuthAuditLog {
  id        String     @id @default(uuid())
  userId    String?
  action    AuthAction
  ipAddress String?
  userAgent String?
  timestamp DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  PROFESSIONAL
  NATIVE
}

enum AgencyWorkerStatus {
  INVITED
  ACTIVE
  REJECTED
  LEAVE_REQUESTED
  LEFT
  INACTIVE
  SUSPENDED
}

enum RequirementStatus {
  DRAFT
  OPEN
  PARTIALLY_FILLED
  FILLED
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
  REPLACEMENT_REQUESTED
  REMOVAL_REQUESTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
  UNPAID
}



enum DocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  CERTIFICATE
  EXPERIENCE_CERTIFICATE
  SKILL_CERTIFICATE
  PHOTO
  OTHER
}

enum DocumentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
  FLEXIBLE
}

enum SalaryType {
  HOURLY
  DAILY
  MONTHLY
  FIXED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EmploymentStatus {
  ACTIVE
  BUSY
  INACTIVE
  ON_LEAVE
  TERMINATED
}

model Worker {
  id     String @id @default(uuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workerCode       String?          @unique
  firstName        String?
  lastName         String?
  phone            String?
  gender           String?
  dateOfBirth      DateTime?
  profilePhoto     String?
  resumeUrl        String?
  jobType          String?
  email            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  district         String?
  state            String?
  country          String?
  postalCode       String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  travelDistance   Int?
  totalExperienceYears Int?
  employmentStatus EmploymentStatus @default(ACTIVE)
  joiningDate      DateTime?
  notes            String?
  expectedDailyWage  String?
  profileStatus WorkerProfileStatus @default(PENDING)
  isOpenToWork Boolean @default(true)

  // Future module relation placeholders (awaiting model implementation)
  skills          WorkerSkill[]
  languages       WorkerLanguage[]
  agencies        AgencyWorker[]

  attendances     WorkerAttendance[]
  leaveRequests   LeaveRequest[]

  documents       WorkerDocument[]

  // categories       WorkerCategory[]
  // bookings         Booking[]

  invoiceItems    InvoiceItem[]



  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  reviews           Review[]
  complaintsFiled   Complaint[] @relation("WorkerComplaints")
  complaintsAgainst Complaint[] @relation("WorkerTargetComplaints")

  @@index([userId])
  @@index([workerCode])
  @@index([deletedAt])
}

model Client {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientCode     String?             @unique
  contactPerson  String?
  phone          String?
  alternatePhone String?
  email          String?
  gstNumber      String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  notes          String?
  profileStatus  ClientProfileStatus @default(ACTIVE)

  // Future module relation placeholders (awaiting model implementation)

  // bookings         Booking[]
  invoices         Invoice[]
  // payments         Payment[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  reviews           Review[]
  complaintsFiled   Complaint[]   @relation("ClientComplaints")
  complaintsAgainst Complaint[]   @relation("ClientTargetComplaints")
  jobTemplates      JobTemplate[]

  @@index([userId])
  @@index([clientCode])
  @@index([deletedAt])
}

model Agency {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agencyCode     String?             @unique
  agencyName     String?
  agencyType     String              @default("CORPORATE")
  contactPerson  String?
  phone          String?
  alternatePhone String?
  email          String?
  gstNumber      String?
  licenseNumber  String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  website        String?
  serviceAreas   String[]
  workingDays    String?
  openTime       String?
  closeTime      String?
  notes          String?
  feePercentage  Float?
  workerFixedAmount Float?
  profileStatus  AgencyProfileStatus @default(PENDING)

  // Document URLs (Optional if using AgencyDocument model)
  logoUrl           String?
  aadhaarUrl        String?
  licenseUrl        String?
  gstCertificateUrl String?
  panUrl            String?

  // Future module relation placeholders
  workers        AgencyWorker[]
  documents      AgencyDocument[]
  // jobRequirements  JobRequirement[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  reviews           Review[]
  complaintsFiled   Complaint[] @relation("AgencyComplaints")
  complaintsAgainst Complaint[] @relation("AgencyTargetComplaints")

  @@index([userId])
  @@index([agencyCode])
  @@index([deletedAt])
}

model Skill {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  // Future module relation placeholders
  workers         WorkerSkill[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  // Future module relation placeholders
  // workers          WorkerCategory[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  jobTemplateItems JobTemplateItem[]

  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
}

model Language {
  id          String  @id @default(uuid())
  name        String  @unique
  code        String  @unique
  description String?
  isActive    Boolean @default(true)

  // Future module relation placeholders
  workers         WorkerLanguage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
}

model Location {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  state       String?
  district    String?
  country     String?
  postalCode  String?
  description String?
  isActive    Boolean @default(true)

  // Future module relation placeholders
  // workers          WorkerLocation[]
  // clients          ClientLocation[]
  // agencies         AgencyLocation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
}

model WorkerSkill {
  id               String           @id @default(uuid())
  workerId         String
  skillId          String
  experienceYears  Int?
  proficiencyLevel SkillProficiency
  isPrimary        Boolean          @default(false)

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, skillId])
  @@index([workerId])
  @@index([skillId])
}

model WorkerLanguage {
  id               String              @id @default(uuid())
  workerId         String
  languageId       String
  proficiencyLevel LanguageProficiency
  canRead          Boolean             @default(false)
  canWrite         Boolean             @default(false)
  canSpeak         Boolean             @default(false)
  isPrimary        Boolean             @default(false)

  worker   Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, languageId])
  @@index([workerId])
  @@index([languageId])
}

model AgencyWorker {
  id         String             @id @default(uuid())
  agencyId   String
  workerId   String
  assignedAt DateTime           @default(now())
  status     AgencyWorkerStatus @default(ACTIVE)
  notes      String?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, workerId])
  @@index([agencyId])
  @@index([workerId])
}













model WorkerAttendance {
  id            String           @id @default(uuid())
  workerId      String
  date          DateTime         @db.Date
  checkInTime   DateTime?
  checkOutTime  DateTime?
  status        AttendanceStatus @default(PRESENT)
  totalHours    Float?
  overtimeHours Float?
  notes         String?

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, date])
  @@index([workerId])
  @@index([date])
}

model LeaveRequest {
  id         String      @id @default(uuid())
  workerId   String
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  leaveType  LeaveType
  status     LeaveStatus @default(PENDING)
  reason     String
  approvedBy String? // Admin or Agency ID who approved

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
  @@index([status])
}



model WorkerDocument {
  id           String         @id @default(uuid())
  workerId     String
  documentType DocumentType
  documentUrl  String // Path or URL to the file
  fileName     String // Original file name
  status       DocumentStatus @default(PENDING_VERIFICATION)
  remarks      String? // Admin remarks on verification

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
  @@index([documentType])
}

model AgencyDocument {
  id           String         @id @default(uuid())
  agencyId     String
  documentType DocumentType
  documentUrl  String
  fileName     String
  status       DocumentStatus @default(PENDING_VERIFICATION)
  remarks      String?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([documentType])
}



enum WorkerProfileStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AgencyProfileStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ClientProfileStatus {
  ACTIVE
  SUSPENDED
}


enum HiringRequestStatus {
  PENDING
  ACCEPTED
  PAYMENT_PENDING
  ACTIVE
  REJECTED
  CANCELLED
}



enum AssignmentStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}





model Review {
  id             String  @id @default(uuid())
  reviewerId     String
  targetWorkerId String?
  targetAgencyId String?

  rating  Int
  comment String?

  reviewer     Client      @relation(fields: [reviewerId], references: [id])
  targetWorker Worker?     @relation(fields: [targetWorkerId], references: [id])
  targetAgency Agency?     @relation(fields: [targetAgencyId], references: [id])


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewerId])
  @@index([targetWorkerId])
  @@index([targetAgencyId])

}

enum ComplaintStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model Complaint {
  id                  String  @id @default(uuid())
  complainantClientId String?
  complainantWorkerId String?
  complainantAgencyId String?

  targetWorkerId String?
  targetAgencyId String?
  targetClientId String?

  title       String
  description String
  status      ComplaintStatus @default(PENDING)

  complainantClient Client? @relation("ClientComplaints", fields: [complainantClientId], references: [id])
  complainantWorker Worker? @relation("WorkerComplaints", fields: [complainantWorkerId], references: [id])
  complainantAgency Agency? @relation("AgencyComplaints", fields: [complainantAgencyId], references: [id])

  targetWorker Worker?     @relation("WorkerTargetComplaints", fields: [targetWorkerId], references: [id])
  targetAgency Agency?     @relation("AgencyTargetComplaints", fields: [targetAgencyId], references: [id])
  targetClient Client?     @relation("ClientTargetComplaints", fields: [targetClientId], references: [id])


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([complainantClientId])
  @@index([complainantWorkerId])
  @@index([complainantAgencyId])
  @@index([targetWorkerId])
  @@index([targetAgencyId])
  @@index([targetClientId])
  @@index([status])
}

model JobTemplate {
  id          String  @id @default(uuid())
  clientId    String
  name        String
  description String?

  items JobTemplateItem[]

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model JobTemplateItem {
  id              String  @id @default(uuid())
  templateId      String
  categoryId      String?
  title           String // e.g., "Mason", "Helper"
  requiredWorkers Int     @default(1)

  template JobTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category Category?   @relation(fields: [categoryId], references: [id])

  @@index([templateId])
  @@index([categoryId])
}

model AdPackage {
  id           String          @id @default(uuid())
  name         String          @unique
  description  String?
  price        Float?          @default(0)
  durationDays Int?            // How many days the ad will run
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  ads          Advertisement[]
}

model Advertisement {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
  linkUrl     String?
  buttonText  String?  @default("Learn More")
  isActive    Boolean  @default(true)
  order       Int      @default(0)

  adPackageId String?
  adPackage   AdPackage? @relation(fields: [adPackageId], references: [id])
  
  expiresAt   DateTime? // Automatically calculated based on package duration

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@index([expiresAt])
}

model SystemSetting {
  id          String  @id @default(uuid())
  key         String  @unique
  value       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}




model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  clientId      String

  subtotal      Decimal
  taxes         Decimal
  grandTotal    Decimal
  status        String        @default("PENDING")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client        Client        @relation(fields: [clientId], references: [id])

  items         InvoiceItem[]
}

model InvoiceItem {
  id            String   @id @default(uuid())
  invoiceId     String
  workerId      String
  description   String
  amount        Decimal
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  worker        Worker   @relation(fields: [workerId], references: [id])
}
