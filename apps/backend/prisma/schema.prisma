generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  DELETED
}

enum ProfileType {
  SUPER_ADMIN
  CLIENT
  AGENCY
  WORKER
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  displayName String
  description String?
  isSystem    Boolean @default(true)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       User[]

  @@index([isActive])
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  displayName String
  description String?
  module      String
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@index([module])
  @@index([isActive])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  status       UserStatus  @default(PENDING)
  profileType  ProfileType

  firstName String?
  lastName  String?
  phone     String?
  avatar    String?
  timezone  String?
  language  String?

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  verificationTokenHash      String?
  verificationTokenExpiresAt DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?

  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  roleId String
  role   Role    @relation(fields: [roleId], references: [id])
  worker Worker?
  client Client?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  agency         Agency?
  authAuditLogs  AuthAuditLog[]
  notifications  Notification[]
  siteSupervisor SiteSupervisor?

  @@index([email])
  @@index([roleId])
  @@index([status])
}

enum AuthAction {
  LOGIN
  LOGOUT
  FAILED_LOGIN
  REFRESH
  PASSWORD_CHANGE
  ACCOUNT_LOCK
}

model AuthAuditLog {
  id        String     @id @default(uuid())
  userId    String?
  action    AuthAction
  ipAddress String?
  userAgent String?
  timestamp DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  PROFESSIONAL
  NATIVE
}

enum AgencyWorkerStatus {
  INVITED
  ACTIVE
  REJECTED
  LEAVE_REQUESTED
  LEFT
  INACTIVE
  SUSPENDED
}

enum RequirementStatus {
  DRAFT
  OPEN
  PARTIALLY_FILLED
  FILLED
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
  REPLACEMENT_REQUESTED
  REMOVAL_REQUESTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
  UNPAID
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
}

enum DocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  CERTIFICATE
  EXPERIENCE_CERTIFICATE
  SKILL_CERTIFICATE
  PHOTO
  OTHER
}

enum DocumentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
  FLEXIBLE
}

enum SalaryType {
  HOURLY
  DAILY
  MONTHLY
  FIXED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EmploymentStatus {
  ACTIVE
  BUSY
  INACTIVE
  ON_LEAVE
  TERMINATED
}

model Worker {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workerCode       String?          @unique
  firstName        String?
  lastName         String?
  phone            String?
  gender           String?
  dateOfBirth      DateTime?
  profilePhoto     String?
  employmentStatus EmploymentStatus @default(ACTIVE)
  joiningDate      DateTime?
  notes            String?

  // Contact Info
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  country                  String?
  postalCode               String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Professional Info
  experienceYears    Int?
  expectedSalary     String?
  preferredLocations Json? // Keep as legacy/array or repurpose
  
  // Work Preferences & Location settings
  workPreferences    Json? // Array of strings (e.g. Daily Work, Contract Work)
  preferredDistrict  String?
  preferredState     String?
  maxTravelDistance  Int?
  willingToRelocate  Boolean @default(false)

  // Future module relation placeholders (awaiting model implementation)
  skills          WorkerSkill[]
  languages       WorkerLanguage[]
  agencies        AgencyWorker[]
  jobApplications JobApplication[]
  savedJobs       SavedJob[]
  attendances     WorkerAttendance[]
  leaveRequests   LeaveRequest[]
  payments        WorkerPayment[]
  documents       WorkerDocument[]
  ignoredJobs     IgnoredJob[]
  // categories       WorkerCategory[]
  // bookings         Booking[]
  hiringRequests  HiringRequest[]
  assignments     AssignmentWorker[]

  // Documents & Financial
  aadhaarNumber     String?
  panNumber         String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?

  profileStatus WorkerProfileStatus @default(PENDING)

  // File URLs
  resumeUrl              String?
  aadhaarUrl             String?
  panUrl                 String?
  bankPassbookUrl        String?
  experienceCertificates Json? // Array of objects/strings stored as JSON
  skillCertificates      Json? // Array of objects/strings stored as JSON

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  reviews     Review[]
  complaints  Complaint[]
  teamMembers TeamMember[]

  @@index([userId])
  @@index([workerCode])
  @@index([deletedAt])
}

model Client {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientCode     String?             @unique
  clientType     String              @default("INDIVIDUAL") // INDIVIDUAL or COMPANY
  companyName    String?
  contactPerson  String?
  phone          String?
  alternatePhone String?
  email          String?
  gstNumber      String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  notes          String?
  profileStatus  ClientProfileStatus @default(ACTIVE)

  // Future module relation placeholders (awaiting model implementation)
  jobRequirements JobRequirement[]
  // bookings         Booking[]
  // invoices         Invoice[]
  // payments         Payment[]
  hiringRequests  HiringRequest[]
  assignments     Assignment[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  reviews         Review[]
  complaints      Complaint[]
  jobTemplates    JobTemplate[]
  projects        Project[]
  siteLocations   SiteLocation[]
  departments     Department[]
  siteSupervisors SiteSupervisor[]
  teams           Team[]

  @@index([userId])
  @@index([clientCode])
  @@index([deletedAt])
}

model Agency {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agencyCode     String?             @unique
  agencyName     String?
  contactPerson  String?
  phone          String?
  alternatePhone String?
  email          String?
  gstNumber      String?
  licenseNumber  String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  notes          String?
  profileStatus  AgencyProfileStatus @default(PENDING)

  // Document URLs (Optional if using AgencyDocument model)
  licenseUrl        String?
  gstCertificateUrl String?
  panUrl            String?

  // Future module relation placeholders
  workers        AgencyWorker[]
  documents      AgencyDocument[]
  // jobRequirements  JobRequirement[]
  hiringRequests HiringRequest[]
  assignments    Assignment[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  reviews    Review[]
  complaints Complaint[]
  teams      Team[]

  @@index([userId])
  @@index([agencyCode])
  @@index([deletedAt])
}

model Skill {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  // Future module relation placeholders
  workers         WorkerSkill[]
  jobRequirements JobRequirementSkill[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  // Future module relation placeholders
  // workers          WorkerCategory[]
  jobRequirements JobRequirement[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  jobTemplateItems JobTemplateItem[]

  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
}

model Language {
  id          String  @id @default(uuid())
  name        String  @unique
  code        String  @unique
  description String?
  isActive    Boolean @default(true)

  // Future module relation placeholders
  workers         WorkerLanguage[]
  jobRequirements JobRequirementLanguage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
}

model Location {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  state       String?
  district    String?
  country     String?
  postalCode  String?
  description String?
  isActive    Boolean @default(true)

  // Future module relation placeholders
  // workers          WorkerLocation[]
  // clients          ClientLocation[]
  // agencies         AgencyLocation[]
  jobRequirements JobRequirement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
}

model WorkerSkill {
  id               String           @id @default(uuid())
  workerId         String
  skillId          String
  experienceYears  Int?
  proficiencyLevel SkillProficiency
  isPrimary        Boolean          @default(false)

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, skillId])
  @@index([workerId])
  @@index([skillId])
}

model WorkerLanguage {
  id               String              @id @default(uuid())
  workerId         String
  languageId       String
  proficiencyLevel LanguageProficiency
  canRead          Boolean             @default(false)
  canWrite         Boolean             @default(false)
  canSpeak         Boolean             @default(false)
  isPrimary        Boolean             @default(false)

  worker   Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, languageId])
  @@index([workerId])
  @@index([languageId])
}

model AgencyWorker {
  id         String             @id @default(uuid())
  agencyId   String
  workerId   String
  assignedAt DateTime           @default(now())
  status     AgencyWorkerStatus @default(ACTIVE)
  notes      String?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, workerId])
  @@index([agencyId])
  @@index([workerId])
}

model JobRequirement {
  id                 String            @id @default(uuid())
  requirementCode    String            @unique
  clientId           String
  title              String
  description        String?
  categoryId         String?
  locationId         String?
  requiredWorkers    Int               @default(1)
  startDate          DateTime?
  endDate            DateTime?
  startTime          String?
  endTime            String?
  salaryType         SalaryType?
  salaryAmount       Decimal?
  priority           Priority          @default(MEDIUM)
  status             RequirementStatus @default(DRAFT)
  shift              ShiftType?
  assignedCount      Int               @default(0)
  cancellationReason String?
  notes              String?
  genderPreference   String?
  experienceRequired String?
  duration           String?

  accommodation Boolean @default(false)
  food          Boolean @default(false)
  transport     Boolean @default(false)

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  // Future module relation placeholders
  // bookings         Booking[]
  hiringRequests    HiringRequest[]
  requiredSkills    JobRequirementSkill[]
  requiredLanguages JobRequirementLanguage[]
  applications      JobApplication[]
  savedBy           SavedJob[]
  ignoredBy         IgnoredJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([categoryId])
  @@index([locationId])
  @@index([status])
  @@index([priority])
  @@index([deletedAt])
}

model JobRequirementSkill {
  id               String           @id @default(uuid())
  jobRequirementId String
  skillId          String
  experienceYears  Int?
  proficiencyLevel SkillProficiency
  isMandatory      Boolean          @default(true)

  jobRequirement JobRequirement @relation(fields: [jobRequirementId], references: [id], onDelete: Cascade)
  skill          Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobRequirementId, skillId])
  @@index([jobRequirementId])
  @@index([skillId])
}

model JobRequirementLanguage {
  id               String              @id @default(uuid())
  jobRequirementId String
  languageId       String
  proficiencyLevel LanguageProficiency
  isMandatory      Boolean             @default(true)

  jobRequirement JobRequirement @relation(fields: [jobRequirementId], references: [id], onDelete: Cascade)
  language       Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobRequirementId, languageId])
  @@index([jobRequirementId])
  @@index([languageId])
}

model JobApplication {
  id               String            @id @default(uuid())
  jobRequirementId String
  workerId         String
  status           ApplicationStatus @default(APPLIED)
  notes            String?
  appliedAt        DateTime          @default(now())

  jobRequirement JobRequirement @relation(fields: [jobRequirementId], references: [id], onDelete: Cascade)
  worker         Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobRequirementId, workerId])
  @@index([jobRequirementId])
  @@index([workerId])
}

model SavedJob {
  id               String @id @default(uuid())
  jobRequirementId String
  workerId         String

  jobRequirement JobRequirement @relation(fields: [jobRequirementId], references: [id], onDelete: Cascade)
  worker         Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([jobRequirementId, workerId])
  @@index([jobRequirementId])
  @@index([workerId])
}

model IgnoredJob {
  id               String @id @default(uuid())
  jobRequirementId String
  workerId         String

  jobRequirement JobRequirement @relation(fields: [jobRequirementId], references: [id], onDelete: Cascade)
  worker         Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([jobRequirementId, workerId])
  @@index([jobRequirementId])
  @@index([workerId])
}

model WorkerAttendance {
  id            String           @id @default(uuid())
  workerId      String
  date          DateTime         @db.Date
  checkInTime   DateTime?
  checkOutTime  DateTime?
  status        AttendanceStatus @default(PRESENT)
  totalHours    Float?
  overtimeHours Float?
  notes         String?

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, date])
  @@index([workerId])
  @@index([date])
}

model LeaveRequest {
  id         String      @id @default(uuid())
  workerId   String
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  leaveType  LeaveType
  status     LeaveStatus @default(PENDING)
  reason     String
  approvedBy String? // Admin or Agency ID who approved

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
  @@index([status])
}

model WorkerPayment {
  id            String         @id @default(uuid())
  workerId      String
  amount        Float
  paymentDate   DateTime?      @db.Date
  periodStart   DateTime       @db.Date
  periodEnd     DateTime       @db.Date
  status        PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  referenceNo   String?
  notes         String?

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
  @@index([status])
}

model WorkerDocument {
  id           String         @id @default(uuid())
  workerId     String
  documentType DocumentType
  documentUrl  String // Path or URL to the file
  fileName     String // Original file name
  status       DocumentStatus @default(PENDING_VERIFICATION)
  remarks      String? // Admin remarks on verification

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
  @@index([documentType])
}

model AgencyDocument {
  id           String         @id @default(uuid())
  agencyId     String
  documentType DocumentType
  documentUrl  String
  fileName     String
  status       DocumentStatus @default(PENDING_VERIFICATION)
  remarks      String?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([documentType])
}

enum NotificationType {
  APPROVAL
  AGENCY_INVITE
  JOB_ASSIGNMENT
  ATTENDANCE_REMINDER
  PAYMENT_PROCESSED
  DOCUMENT_EXPIRY
  PROFILE_ALERT
  SYSTEM
  HIRING_ACCEPTED
  HIRING_REJECTED
  ASSIGNMENT_STARTED
  ASSIGNMENT_COMPLETED
}

enum WorkerProfileStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AgencyProfileStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ClientProfileStatus {
  ACTIVE
  SUSPENDED
}

model Notification {
  id      String           @id @default(uuid())
  userId  String
  type    NotificationType @default(SYSTEM)
  title   String
  message String
  isRead  Boolean          @default(false)
  link    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
}

enum HiringRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model HiringRequest {
  id               String  @id @default(uuid())
  clientId         String
  targetAgencyId   String?
  targetWorkerId   String?
  jobRequirementId String?

  title        String
  description  String?
  proposedRate Decimal?
  startDate    DateTime?
  endDate      DateTime?
  notes        String?

  status HiringRequestStatus @default(PENDING)

  client         Client          @relation(fields: [clientId], references: [id])
  agency         Agency?         @relation(fields: [targetAgencyId], references: [id])
  worker         Worker?         @relation(fields: [targetWorkerId], references: [id])
  jobRequirement JobRequirement? @relation(fields: [jobRequirementId], references: [id])

  assignment Assignment?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  @@index([clientId])
  @@index([targetAgencyId])
  @@index([targetWorkerId])
  @@index([status])
}

enum AssignmentStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Assignment {
  id              String  @id @default(uuid())
  assignmentCode  String  @unique
  hiringRequestId String? @unique
  clientId        String
  agencyId        String?

  title       String
  description String?
  agreedRate  Decimal?
  startDate   DateTime?
  endDate     DateTime?

  status AssignmentStatus @default(ACTIVE)

  hiringRequest HiringRequest? @relation(fields: [hiringRequestId], references: [id])
  client        Client         @relation(fields: [clientId], references: [id])
  agency        Agency?        @relation(fields: [agencyId], references: [id])

  assignedWorkers AssignmentWorker[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  reviews         Review[]
  complaints      Complaint[]
  project         Project?         @relation(fields: [projectId], references: [id])
  projectId       String?
  siteLocation    SiteLocation?    @relation(fields: [siteLocationId], references: [id])
  siteLocationId  String?
  assignmentTeams AssignmentTeam[]

  @@index([clientId])
  @@index([agencyId])
  @@index([status])
}

model AssignmentWorker {
  id           String   @id @default(uuid())
  assignmentId String
  workerId     String
  assignedAt   DateTime @default(now())
  status       String   @default("ACTIVE") // ACTIVE, REMOVED

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  worker     Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, workerId])
  @@index([assignmentId])
  @@index([workerId])
}

model Review {
  id             String  @id @default(uuid())
  reviewerId     String
  targetWorkerId String?
  targetAgencyId String?
  assignmentId   String?

  rating  Int
  comment String?

  reviewer     Client      @relation(fields: [reviewerId], references: [id])
  targetWorker Worker?     @relation(fields: [targetWorkerId], references: [id])
  targetAgency Agency?     @relation(fields: [targetAgencyId], references: [id])
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewerId])
  @@index([targetWorkerId])
  @@index([targetAgencyId])
  @@index([assignmentId])
}

enum ComplaintStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model Complaint {
  id             String  @id @default(uuid())
  complainantId  String
  targetWorkerId String?
  targetAgencyId String?
  assignmentId   String?

  title       String
  description String
  status      ComplaintStatus @default(PENDING)

  complainant  Client      @relation(fields: [complainantId], references: [id])
  targetWorker Worker?     @relation(fields: [targetWorkerId], references: [id])
  targetAgency Agency?     @relation(fields: [targetAgencyId], references: [id])
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([complainantId])
  @@index([targetWorkerId])
  @@index([targetAgencyId])
  @@index([status])
}

model JobTemplate {
  id          String  @id @default(uuid())
  clientId    String
  name        String
  description String?

  items JobTemplateItem[]

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model JobTemplateItem {
  id              String  @id @default(uuid())
  templateId      String
  categoryId      String?
  title           String // e.g., "Mason", "Helper"
  requiredWorkers Int     @default(1)

  template JobTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category Category?   @relation(fields: [categoryId], references: [id])

  @@index([templateId])
  @@index([categoryId])
}

model Project {
  id          String        @id @default(uuid())
  clientId    String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)

  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sites       SiteLocation[]
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model SiteLocation {
  id        String  @id @default(uuid())
  projectId String?
  clientId  String
  name      String
  address   String?
  city      String?
  state     String?

  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  supervisors SiteSupervisor[]
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([clientId])
}

model Department {
  id       String @id @default(uuid())
  clientId String
  name     String

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hiringRequests HiringRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model SiteSupervisor {
  id       String  @id @default(uuid())
  userId   String  @unique
  clientId String
  siteId   String?

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site   SiteLocation? @relation(fields: [siteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([siteId])
}

model Team {
  id       String  @id @default(uuid())
  name     String
  agencyId String?
  clientId String?

  members     TeamMember[]
  assignments AssignmentTeam[]

  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([clientId])
}

model TeamMember {
  id       String @id @default(uuid())
  teamId   String
  workerId String

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([teamId, workerId])
  @@index([teamId])
  @@index([workerId])
}

model AssignmentTeam {
  id           String @id @default(uuid())
  assignmentId String
  teamId       String

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, teamId])
  @@index([assignmentId])
  @@index([teamId])
}
